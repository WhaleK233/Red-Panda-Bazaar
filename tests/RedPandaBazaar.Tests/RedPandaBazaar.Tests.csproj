<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>Red_Panda_Bazaar_Code.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- CI 与本机都只保证有最新 SDK，不保证有 net6 运行时；向前滚到已装的最高主版本跑测试 -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <!-- 仓库校验与 RC 版本工具（纯 net6.0，无游戏依赖） -->
    <ItemGroup>
        <ProjectReference Include="..\..\tools\RedPandaBazaar.RepoTools\RedPandaBazaar.RepoTools.csproj"/>
    </ItemGroup>

    <!-- 以链接方式编译 mod 中的纯逻辑源文件：不引用 mod 工程（会连带触发游戏依赖、
         构建与部署副作用），文件一旦引入游戏类型，这里的链接编译会立刻失败，
         那就是「该文件不再可测」的信号——把它从列表中移出，而不是给测试补游戏引用。 -->
    <ItemGroup>
        <Compile Include="..\..\src\RedPandaBazaar\Features\PlayerStall\StallSettlementMath.cs"
                 Link="Linked\StallSettlementMath.cs"/>
    </ItemGroup>

</Project>
