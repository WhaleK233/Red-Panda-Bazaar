<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>Red_Panda_Bazaar_Code</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableHarmony>true</EnableHarmony>
        <OutputPath>out\</OutputPath>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    </ItemGroup>

    <!-- CP 以仓库内副本为源部署到 Mods；SVN 同步不随构建执行，由 agent 按 AGENTS.md「SVN 流程」手动跑 -->
    <Target Name="DeployCP" BeforeTargets="BeforeBuild">
        <Exec Command="if exist &quot;$(GameModsPath)\[CP]Red Panda Bazaar&quot; rmdir /s /q &quot;$(GameModsPath)\[CP]Red Panda Bazaar&quot;"
              ContinueOnError="true"/>
        <ItemGroup>
            <CpToMods Include="$(ProjectDir)..\[CP]Red Panda Bazaar\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(CpToMods)"
              DestinationFolder="$(GameModsPath)\[CP]Red Panda Bazaar\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"/>
    </Target>

    <Target Name="UpdateModVersion" BeforeTargets="BeforeBuild">
        <Exec Command="python &quot;$(ProjectDir)scripts\UpdateVersion.py&quot;"/>
    </Target>

    <!-- 公共源码（UI 框架/物品序列化/随机与时间工具/GMCM 接口），见 MySDVMods/Common -->
    <Import Project="..\..\Common\WhaleK.Common.projitems" Label="Shared"/>

</Project>
