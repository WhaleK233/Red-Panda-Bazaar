<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <!-- StardewUI.Core 源码使用 C# 12 语法（集合表达式等），高于 net6.0 默认的 C# 10 -->
        <LangVersion>Latest</LangVersion>
        <RootNamespace>Red_Panda_Bazaar_Code</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableHarmony>true</EnableHarmony>
        <OutputPath>out\</OutputPath>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    </ItemGroup>

    <!-- StardewUI.Core 的 Data 解析依赖 SMAPI 内置的 Newtonsoft.Json -->
    <ItemGroup>
        <Reference Include="Newtonsoft.Json" Private="False">
            <HintPath>$(GamePath)\smapi-internal\Newtonsoft.Json.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- StardewUI.Core 源码依赖的全局 using 与类型别名，与其官方 csproj 保持一致 -->
    <ItemGroup>
        <Using Include="StardewValley" />
        <Using Include="StardewModdingAPI" />
        <Using Alias="Object" Include="System.Object" />
        <Using Alias="SObject" Include="StardewValley.Object" />
        <Using Alias="Color" Include="Microsoft.Xna.Framework.Color" />
        <Using Alias="Rectangle" Include="Microsoft.Xna.Framework.Rectangle" />
        <Using Alias="Vector2" Include="Microsoft.Xna.Framework.Vector2" />
        <Using Alias="Trace" Include="StardewUI.Diagnostics.Trace" />
    </ItemGroup>

    <!-- CP 以仓库内副本为源部署到 Mods；CP 包更新不随构建同步，需手动处理 -->
    <Target Name="DeployCP" BeforeTargets="BeforeBuild">
        <Exec Command="if exist &quot;$(GameModsPath)\[CP]Red Panda Bazaar&quot; rmdir /s /q &quot;$(GameModsPath)\[CP]Red Panda Bazaar&quot;"
              ContinueOnError="true"/>
        <ItemGroup>
            <CpToMods Include="$(ProjectDir)..\[CP]Red Panda Bazaar\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(CpToMods)"
              DestinationFolder="$(GameModsPath)\[CP]Red Panda Bazaar\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"/>
    </Target>

    <Target Name="UpdateModVersion" BeforeTargets="BeforeBuild">
        <Exec Command="python &quot;$(ProjectDir)scripts\UpdateVersion.py&quot;"/>
    </Target>

    <!-- StardewUI Core（共享源码项目，本 mod 的 UI 框架），默认取 Projects 下的本地副本 -->
    <PropertyGroup>
        <StardewUICorePath Condition="'$(StardewUICorePath)' == ''">..\..\..\..\Projects\StardewUI\Core</StardewUICorePath>
    </PropertyGroup>
    <Import Project="$(StardewUICorePath)\StardewUI.projitems" Label="Shared"/>

</Project>
